{
  "name": "lagos-hustle",
  "main": "worker.js",
  "compatibility_date": "2026-10-09",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lagos-hustle-db",
      "database_id": "KEEP_YOUR_EXISTING_DATABASE_ID"
    }
  ]
}
